# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# GEMINI_MODEL: Configurable model name for AI workflows (e.g. gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="http://localhost:3000"

# MONGODB_URI: Connection string for persistent MongoDB storage.
# For local MongoDB: mongodb://127.0.0.1:27017/careercraft_ai
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/careercraft_ai?retryWrites=true&w=majority
MONGODB_URI="mongodb://127.0.0.1:27017/careercraft_ai"

# PORT: Port to run development and production server (default: 3000)
PORT=3000
